{
  "run": {
    "timeout": "5m"
  },
  "linters": {
    "enable": [
      "gocyclo",
      "revive",
      "goconst",
      "misspell",
      "ineffassign",
      "lll",
      "govet",
      "gosec",
      "dupl",
      "unconvert",
      "errcheck",
      "staticcheck"
    ],
    "settings": {
      "dupl": {
        "threshold": 100
      },
      "lll": {
        "line-length": 120
      },
      "gocyclo": {
        "min-complexity": 12
      },
      "revive": {
        "rules": [
          { "name": "package-comments", "disabled": true },
          { "name": "exported", "disabled": true },
          { "name": "var-naming", "disabled": true }
        ]
      }
    },
    "exclusions": {
      "rules": [
        {
          "path": "_test.go",
          "linters": [
          "gocyclo",
          "errcheck",
          "dupl",
          "gosec",
          "goconst"
          ]
        },
        {
          "linters": ["staticcheck"],
          "text": "ST1005"
        }
      ]
    }
  },
  "version": "2"
}
